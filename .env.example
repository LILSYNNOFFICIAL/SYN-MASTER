# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically provisions and injects this server-side secret for hosted apps.
# For hosting outside AI Studio, the service operator sets it in backend secret storage.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional dedicated backend-only signing key for anonymous HttpOnly guest sessions.
# AI Studio already supplies GEMINI_API_KEY as a server-side secret. If this override is
# omitted, SYN-MASTER derives a separate, stable HKDF signing key from GEMINI_API_KEY so
# Cloud Run replicas share the same cookie-validation key without extra deployment setup.
# If set, generate a distinct value with: openssl rand -hex 32
# SYN_MASTER_SESSION_SECRET="";

# Cloud Run automatically trusts its single proxy hop when K_SERVICE is present.
# For other known reverse-proxy deployments, set TRUST_PROXY_HOPS explicitly (for example 1).
# Leave unset for direct/local servers so untrusted forwarded headers are ignored.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional cloud AI spend caps for the Gemini routes (defaults shown). Each is a positive integer.
# The global daily cap uses a Firestore transaction in production to coordinate Cloud Run replicas.
# Enable the Firestore API, create a Native-mode database, and grant the Cloud Run service account
# roles/datastore.user. Cloud Run project ID is detected automatically; override only if needed.
# SYN_AI_SPEND_PROJECT_ID="my-google-cloud-project"
# SYN_AI_SPEND_DATABASE="(default)"
# SYN_AI_STRATEGY_PER_MINUTE=3
# SYN_AI_REFINE_PER_MINUTE=12
# SYN_AI_STRATEGY_PER_DAY=40
# SYN_AI_CLIENT_PER_DAY=250
# SYN_AI_GLOBAL_PER_DAY=2000
