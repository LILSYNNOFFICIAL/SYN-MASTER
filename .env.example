# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SYN_MASTER_SESSION_SECRET: backend-only signing key for anonymous HttpOnly guest sessions.
# Generate once and store only in the server secret manager: openssl rand -hex 32
SYN_MASTER_SESSION_SECRET="GENERATE_A_RANDOM_64_CHARACTER_HEX_SECRET"

# Cloud Run: set TRUST_PROXY_HOPS=1 when requests arrive through one trusted proxy hop.
# Leave unset for direct/local servers. This lets Express validate HTTPS Origin and Secure cookies.
# TRUST_PROXY_HOPS=1

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional cloud AI spend caps for the Gemini routes (defaults shown). Each is a positive integer.
# SYN_AI_STRATEGY_PER_MINUTE=3
# SYN_AI_REFINE_PER_MINUTE=12
# SYN_AI_STRATEGY_PER_DAY=40
# SYN_AI_CLIENT_PER_DAY=250
# SYN_AI_GLOBAL_PER_DAY=2000
