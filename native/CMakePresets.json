{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows 11 x64 (VS 2022 Release)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYN_USE_JUCE": "ON",
        "SYN_ENABLE_ASIO": "OFF"
      }
    },
    {
      "name": "windows-x64-ninja",
      "displayName": "Windows 11 x64 (Ninja Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYN_USE_JUCE": "ON",
        "SYN_ENABLE_ASIO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-ninja",
      "configurePreset": "windows-x64-ninja"
    }
  ]
}
